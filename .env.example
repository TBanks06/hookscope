# Copy to .env and adjust. docker-compose currently inlines dev values.
SECRET_KEY=change-me-32+chars
DATABASE_URL=postgresql+asyncpg://hookscope:hookscope@localhost:5432/hookscope
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_INGEST_BASE=http://localhost:8000/api/v1/hooks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
